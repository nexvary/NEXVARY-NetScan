<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- App / toolbar -->
    <DataTemplate x:Key="AppLogoTemplate">
        <Viewbox Width="48" Height="48">
            <Canvas Width="48" Height="48">
                <Rectangle Width="48" Height="48" RadiusX="12" RadiusY="12">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#063B66" Offset="0"/>
                            <GradientStop Color="#114E91" Offset=".5"/>
                            <GradientStop Color="#44257D" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Line X1="14" Y1="14" X2="24" Y2="24" Stroke="#62E6FF" StrokeThickness="2.6"/>
                <Line X1="34" Y1="12" X2="24" Y2="24" Stroke="#7DF07A" StrokeThickness="2.6"/>
                <Line X1="13" Y1="35" X2="24" Y2="24" Stroke="#FFD45C" StrokeThickness="2.6"/>
                <Line X1="36" Y1="35" X2="24" Y2="24" Stroke="#D07BFF" StrokeThickness="2.6"/>
                <Ellipse Canvas.Left="8" Canvas.Top="8" Width="12" Height="12" Fill="#27C7FF" Stroke="#A8F0FF" StrokeThickness="1"/>
                <Ellipse Canvas.Left="29" Canvas.Top="7" Width="12" Height="12" Fill="#73E95D" Stroke="#D6FFD1" StrokeThickness="1"/>
                <Ellipse Canvas.Left="7" Canvas.Top="29" Width="12" Height="12" Fill="#FFBA43" Stroke="#FFF0B5" StrokeThickness="1"/>
                <Ellipse Canvas.Left="30" Canvas.Top="29" Width="12" Height="12" Fill="#B65CFF" Stroke="#EDC9FF" StrokeThickness="1"/>
                <Ellipse Canvas.Left="18" Canvas.Top="18" Width="12" Height="12" Fill="#F4FBFF" Stroke="#66D7FF" StrokeThickness="1.2"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ScanIconTemplate">
        <Viewbox Width="22" Height="22">
            <Canvas Width="24" Height="24">
                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="13" Height="13" Stroke="#73E7FF" StrokeThickness="2.4"/>
                <Line X1="14" Y1="14" X2="21" Y2="21" Stroke="#28C9E8" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Ellipse Canvas.Left="7" Canvas.Top="7" Width="5" Height="5" Fill="#9EF1FF"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="StopIconTemplate">
        <Viewbox Width="20" Height="20">
            <Canvas Width="24" Height="24">
                <Rectangle Canvas.Left="4" Canvas.Top="4" Width="16" Height="16" RadiusX="4" RadiusY="4" Fill="#FF5B6E" Stroke="#FF9AA6" StrokeThickness="1.4"/>
                <Rectangle Canvas.Left="8" Canvas.Top="8" Width="8" Height="8" RadiusX="1.5" RadiusY="1.5" Fill="#FFF0F2"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="CopyIconTemplate">
        <Viewbox Width="20" Height="20">
            <Canvas Width="24" Height="24">
                <Rectangle Canvas.Left="7" Canvas.Top="4" Width="11" Height="14" RadiusX="2" RadiusY="2" Fill="#2F78D8" Stroke="#8FC5FF" StrokeThickness="1.3"/>
                <Rectangle Canvas.Left="4" Canvas.Top="7" Width="11" Height="14" RadiusX="2" RadiusY="2" Fill="#173A66" Stroke="#6DB3FF" StrokeThickness="1.3"/>
                <Line X1="7" Y1="11" X2="12" Y2="11" Stroke="#A9D5FF" StrokeThickness="1.3"/>
                <Line X1="7" Y1="14" X2="12" Y2="14" Stroke="#A9D5FF" StrokeThickness="1.3"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="CsvIconTemplate">
        <Viewbox Width="20" Height="20">
            <Canvas Width="24" Height="24">
                <Path Data="M5,2 H15 L20,7 V22 H5 Z" Fill="#145A74" Stroke="#5DDBFF" StrokeThickness="1.3"/>
                <Path Data="M15,2 V7 H20" Fill="Transparent" Stroke="#B8F3FF" StrokeThickness="1.2"/>
                <Rectangle Canvas.Left="7" Canvas.Top="11" Width="11" Height="6" RadiusX="1.5" RadiusY="1.5" Fill="#26B7D7"/>
                <TextBlock Canvas.Left="8.1" Canvas.Top="11.3" Text="CSV" FontSize="4.8" FontWeight="Bold" Foreground="White"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="TrashIconTemplate">
        <Viewbox Width="18" Height="18">
            <Canvas Width="24" Height="24">
                <Path Data="M7,8 H18 L17,21 H8 Z" Fill="#A53543" Stroke="#FF8B98" StrokeThickness="1.2"/>
                <Rectangle Canvas.Left="6" Canvas.Top="5" Width="13" Height="3" RadiusX="1.3" RadiusY="1.3" Fill="#FF7182"/>
                <Rectangle Canvas.Left="10" Canvas.Top="2.5" Width="5" Height="2.5" RadiusX="1" RadiusY="1" Fill="#FFD7DC"/>
                <Line X1="11" Y1="11" X2="11" Y2="18" Stroke="#FFD2D7" StrokeThickness="1.1"/>
                <Line X1="14" Y1="11" X2="14" Y2="18" Stroke="#FFD2D7" StrokeThickness="1.1"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- Summary card icons -->
    <DataTemplate x:Key="ConnectedDevicesIconTemplate">
        <Viewbox Width="38" Height="38">
            <Canvas Width="40" Height="40">
                <Ellipse Canvas.Left="15" Canvas.Top="5" Width="10" Height="10" Fill="#48A7FF"/>
                <Ellipse Canvas.Left="5" Canvas.Top="12" Width="9" Height="9" Fill="#5ED0FF"/>
                <Ellipse Canvas.Left="26" Canvas.Top="12" Width="9" Height="9" Fill="#2C78E5"/>
                <Path Data="M11,34 C11,26 15,22 20,22 C25,22 29,26 29,34 Z" Fill="#2F8BFF"/>
                <Path Data="M2,34 C2,28 5,24 10,24 C12,24 14,25 15,27 C13,29 12,31 12,34 Z" Fill="#52B8FF"/>
                <Path Data="M28,34 C28,31 27,29 25,27 C27,25 29,24 31,24 C36,24 39,28 39,34 Z" Fill="#2464C8"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="SubnetIconTemplate">
        <Viewbox Width="38" Height="38">
            <Canvas Width="40" Height="40">
                <Line X1="20" Y1="11" X2="9" Y2="27" Stroke="#4EF58A" StrokeThickness="2.4"/>
                <Line X1="20" Y1="11" X2="31" Y2="27" Stroke="#4EF58A" StrokeThickness="2.4"/>
                <Line X1="9" Y1="27" X2="31" Y2="27" Stroke="#22B85A" StrokeThickness="2.4"/>
                <Rectangle Canvas.Left="15" Canvas.Top="4" Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#2BE66D" Stroke="#B5FFD0" StrokeThickness="1"/>
                <Rectangle Canvas.Left="3" Canvas.Top="24" Width="11" Height="10" RadiusX="2" RadiusY="2" Fill="#168D43" Stroke="#7BFFAC" StrokeThickness="1"/>
                <Rectangle Canvas.Left="26" Canvas.Top="24" Width="11" Height="10" RadiusX="2" RadiusY="2" Fill="#168D43" Stroke="#7BFFAC" StrokeThickness="1"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- Device icons -->
    <DataTemplate x:Key="RouterIconTemplate">
        <Viewbox Width="38" Height="38">
            <Canvas Width="40" Height="40">
                <Line X1="9" Y1="16" X2="9" Y2="5" Stroke="#AAB7C4" StrokeThickness="2.2" StrokeStartLineCap="Round"/>
                <Line X1="31" Y1="16" X2="31" Y2="5" Stroke="#AAB7C4" StrokeThickness="2.2" StrokeStartLineCap="Round"/>
                <Path Data="M12,14 C16,10 24,10 28,14" Stroke="#39B6FF" StrokeThickness="2" Fill="Transparent"/>
                <Path Data="M15,16 C18,13.5 22,13.5 25,16" Stroke="#74D6FF" StrokeThickness="1.8" Fill="Transparent"/>
                <Rectangle Canvas.Left="5" Canvas.Top="17" Width="30" Height="14" RadiusX="4" RadiusY="4" Fill="#172B3C" Stroke="#5D7183" StrokeThickness="1.2"/>
                <Rectangle Canvas.Left="8" Canvas.Top="20" Width="24" Height="6" RadiusX="2" RadiusY="2">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#203E55" Offset="0"/>
                            <GradientStop Color="#142634" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Ellipse Canvas.Left="9" Canvas.Top="27" Width="3" Height="3" Fill="#27C8FF"/>
                <Ellipse Canvas.Left="14" Canvas.Top="27" Width="3" Height="3" Fill="#4EF58A"/>
                <Ellipse Canvas.Left="19" Canvas.Top="27" Width="3" Height="3" Fill="#FFD35A"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="NetworkDeviceIconTemplate">
        <Viewbox Width="38" Height="38">
            <Canvas Width="40" Height="40">
                <Ellipse Canvas.Left="9" Canvas.Top="8" Width="22" Height="22" Fill="#E8EEF4" Stroke="#AAB8C4" StrokeThickness="1.1"/>
                <Ellipse Canvas.Left="13" Canvas.Top="12" Width="14" Height="14" Fill="#C9D5DF" Stroke="#78A5D1" StrokeThickness="1"/>
                <Ellipse Canvas.Left="17" Canvas.Top="16" Width="6" Height="6" Fill="#3B9EFF"/>
                <Path Data="M10,30 C13,34 27,34 30,30" Fill="#73889A"/>
                <Path Data="M14,9 C17,5 23,5 26,9" Stroke="#35C7FF" StrokeThickness="1.8" Fill="Transparent"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="PhoneIconTemplate">
        <Viewbox Width="38" Height="38">
            <Canvas Width="40" Height="40">
                <Rectangle Canvas.Left="11" Canvas.Top="3" Width="18" Height="34" RadiusX="4" RadiusY="4" Fill="#101820" Stroke="#A8B8C8" StrokeThickness="1.2"/>
                <Rectangle Canvas.Left="13" Canvas.Top="6" Width="14" Height="25" RadiusX="2" RadiusY="2">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1EC8FF" Offset="0"/>
                            <GradientStop Color="#5D63FF" Offset=".48"/>
                            <GradientStop Color="#E34CBE" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Ellipse Canvas.Left="18.5" Canvas.Top="33" Width="3" Height="3" Fill="#D9E3EA"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="CameraIconTemplate">
        <Viewbox Width="38" Height="38">
            <Canvas Width="40" Height="40">
                <Path Data="M7,12 L30,8 L34,18 L11,23 Z" Fill="#E7EDF3" Stroke="#9DAAB6" StrokeThickness="1.1"/>
                <Ellipse Canvas.Left="25" Canvas.Top="10" Width="9" Height="9" Fill="#18324C" Stroke="#55C8FF" StrokeThickness="1.6"/>
                <Ellipse Canvas.Left="28" Canvas.Top="13" Width="3" Height="3" Fill="#8DEAFF"/>
                <Path Data="M12,23 L18,26 L14,34 H8 Z" Fill="#C2CDD6" Stroke="#8897A5" StrokeThickness="1"/>
                <Rectangle Canvas.Left="6" Canvas.Top="32" Width="13" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#8897A5"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="ComputerIconTemplate">
        <Viewbox Width="38" Height="38">
            <Canvas Width="40" Height="40">
                <Rectangle Canvas.Left="3" Canvas.Top="6" Width="25" Height="20" RadiusX="2.5" RadiusY="2.5" Fill="#162B42" Stroke="#6E9AC4" StrokeThickness="1.2"/>
                <Rectangle Canvas.Left="5" Canvas.Top="8" Width="21" Height="16" RadiusX="1.5" RadiusY="1.5">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0A70D7" Offset="0"/>
                            <GradientStop Color="#2A9CFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Canvas.Left="13" Canvas.Top="26" Width="5" Height="5" Fill="#93A9BC"/>
                <Rectangle Canvas.Left="9" Canvas.Top="31" Width="13" Height="2.5" RadiusX="1" RadiusY="1" Fill="#6F8395"/>
                <Rectangle Canvas.Left="30" Canvas.Top="8" Width="7" Height="26" RadiusX="1.5" RadiusY="1.5" Fill="#252D35" Stroke="#778695" StrokeThickness="1"/>
                <Ellipse Canvas.Left="32" Canvas.Top="29" Width="2" Height="2" Fill="#4EF58A"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="PrinterIconTemplate">
        <Viewbox Width="38" Height="38">
            <Canvas Width="40" Height="40">
                <Rectangle Canvas.Left="10" Canvas.Top="3" Width="20" Height="11" RadiusX="2" RadiusY="2" Fill="#F1F4F7" Stroke="#A9B3BC" StrokeThickness="1"/>
                <Rectangle Canvas.Left="5" Canvas.Top="13" Width="30" Height="16" RadiusX="4" RadiusY="4" Fill="#455766" Stroke="#8FA0AE" StrokeThickness="1.1"/>
                <Rectangle Canvas.Left="9" Canvas.Top="24" Width="22" Height="13" RadiusX="2" RadiusY="2" Fill="#F6FAFD" Stroke="#9CAAB6" StrokeThickness="1"/>
                <Ellipse Canvas.Left="29" Canvas.Top="17" Width="3" Height="3" Fill="#4EF58A"/>
                <Line X1="13" Y1="29" X2="27" Y2="29" Stroke="#6D7F8F" StrokeThickness="1.2"/>
                <Line X1="13" Y1="32" X2="25" Y2="32" Stroke="#9AA9B5" StrokeThickness="1.2"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="TvIconTemplate">
        <Viewbox Width="38" Height="38">
            <Canvas Width="40" Height="40">
                <Rectangle Canvas.Left="4" Canvas.Top="7" Width="32" Height="23" RadiusX="3" RadiusY="3" Fill="#111D2A" Stroke="#72859B" StrokeThickness="1.2"/>
                <Rectangle Canvas.Left="7" Canvas.Top="10" Width="26" Height="17" RadiusX="2" RadiusY="2">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#173E80" Offset="0"/>
                            <GradientStop Color="#6A4FD0" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Line X1="16" Y1="31" X2="24" Y2="31" Stroke="#9BA9B4" StrokeThickness="2"/>
                <Line X1="20" Y1="30" X2="20" Y2="35" Stroke="#9BA9B4" StrokeThickness="2"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="IotIconTemplate">
        <Viewbox Width="38" Height="38">
            <Canvas Width="40" Height="40">
                <Ellipse Canvas.Left="10" Canvas.Top="4" Width="20" Height="20" Fill="#FFD04D" Stroke="#FFF1A8" StrokeThickness="1.1"/>
                <Path Data="M15,19 C17,23 17,26 17,28 H23 C23,26 23,23 25,19" Fill="#E9A832"/>
                <Rectangle Canvas.Left="16" Canvas.Top="28" Width="8" Height="6" RadiusX="2" RadiusY="2" Fill="#5D6873"/>
                <Line X1="20" Y1="1" X2="20" Y2="4" Stroke="#FFE57E" StrokeThickness="2"/>
                <Line X1="7" Y1="10" X2="10" Y2="12" Stroke="#FFE57E" StrokeThickness="2"/>
                <Line X1="33" Y1="10" X2="30" Y2="12" Stroke="#FFE57E" StrokeThickness="2"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <DataTemplate x:Key="GenericDeviceIconTemplate">
        <Viewbox Width="38" Height="38">
            <Canvas Width="40" Height="40">
                <Rectangle Canvas.Left="7" Canvas.Top="7" Width="26" Height="26" RadiusX="6" RadiusY="6" Fill="#283846" Stroke="#718493" StrokeThickness="1.2"/>
                <Rectangle Canvas.Left="11" Canvas.Top="11" Width="18" Height="11" RadiusX="2" RadiusY="2" Fill="#17242F"/>
                <Ellipse Canvas.Left="12" Canvas.Top="27" Width="3" Height="3" Fill="#4EF58A"/>
                <Ellipse Canvas.Left="18" Canvas.Top="27" Width="3" Height="3" Fill="#38D8C8"/>
                <Ellipse Canvas.Left="24" Canvas.Top="27" Width="3" Height="3" Fill="#6A88A0"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <Style x:Key="DeviceIconHostStyle" TargetType="ContentControl">
        <Setter Property="ContentTemplate" Value="{StaticResource GenericDeviceIconTemplate}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IconKind}" Value="Router">
                <Setter Property="ContentTemplate" Value="{StaticResource RouterIconTemplate}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="Network">
                <Setter Property="ContentTemplate" Value="{StaticResource NetworkDeviceIconTemplate}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="Phone">
                <Setter Property="ContentTemplate" Value="{StaticResource PhoneIconTemplate}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="Camera">
                <Setter Property="ContentTemplate" Value="{StaticResource CameraIconTemplate}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="Computer">
                <Setter Property="ContentTemplate" Value="{StaticResource ComputerIconTemplate}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="Printer">
                <Setter Property="ContentTemplate" Value="{StaticResource PrinterIconTemplate}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="Tv">
                <Setter Property="ContentTemplate" Value="{StaticResource TvIconTemplate}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="IoT">
                <Setter Property="ContentTemplate" Value="{StaticResource IotIconTemplate}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
