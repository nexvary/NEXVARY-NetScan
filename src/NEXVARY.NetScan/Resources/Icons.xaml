    <Style x:Key="DeviceIconHostStyle" TargetType="ContentControl">
        <Setter Property="ContentTemplate" Value="{StaticResource GenericDeviceIconTemplate}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IconKind}" Value="Router">
                <Setter Property="ContentTemplate" Value="{StaticResource RouterIconTemplate}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="Network">
                <Setter Property="ContentTemplate" Value="{StaticResource NetworkDeviceIconTemplate}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="Phone">
                <Setter Property="ContentTemplate" Value="{StaticResource PhoneIconTemplate}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IconKind}" Value="Camera">
