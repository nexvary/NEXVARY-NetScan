<Window x:Class="NEXVARY.NetScan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXVARY NetScan"
        Loaded="MainWindow_Loaded"
        Width="1220" Height="760" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FlowDirection="RightToLeft">
    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#16232D"/>
            <Setter Property="Foreground" Value="#B8C6D1"/>
            <Setter Property="BorderBrush" Value="#263744"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#1F303C"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="#1F303C"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#172935"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1B3A3B"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Background" Value="#101B24"/>
            <Setter Property="BorderBrush" Value="#29404E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="3,3,3,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#17474B"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2E8E8B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#19303C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="64" Height="64" CornerRadius="18" Background="#101E2A" BorderBrush="#31546B" BorderThickness="1" Margin="0,0,14,0">
                <ContentControl ContentTemplate="{StaticResource AppLogoTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="NEXVARY NetScan" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="اكتشف الأجهزة، الشركة المصنعة، ونشاط الشبكة بدون أوامر" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
                <Button x:Name="ExportButton" Click="ExportButton_Click" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                        <TextBlock Text="تصدير CSV" VerticalAlignment="Center"/>
                        <ContentControl ContentTemplate="{StaticResource CsvIconTemplate}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CopyButton" Click="CopyButton_Click" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                        <TextBlock Text="نسخ النتائج" VerticalAlignment="Center"/>
                        <ContentControl ContentTemplate="{StaticResource CopyIconTemplate}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="StopButton" Click="StopButton_Click" IsEnabled="False" Background="#392228" BorderBrush="#66323C">
                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                        <TextBlock Text="إيقاف" VerticalAlignment="Center"/>
                        <ContentControl ContentTemplate="{StaticResource StopIconTemplate}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ScanButton" Click="ScanButton_Click" Background="#126B67" BorderBrush="#2AA79F" FontWeight="Bold" Padding="22,10">
                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                        <TextBlock Text="اكتشاف الأجهزة" VerticalAlignment="Center"/>
                        <ContentControl ContentTemplate="{StaticResource ScanIconTemplate}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="-5,0,-5,16">
            <Border Style="{StaticResource CardBorder}" Margin="5">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="الأجهزة المتصلة الآن" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        <TextBlock x:Name="DeviceCountText" Text="0" FontSize="25" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                    <ContentControl Grid.Column="1" ContentTemplate="{StaticResource ConnectedDevicesIconTemplate}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="5">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="الشبكة" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        <TextBlock x:Name="NetworkText" Text="—" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,0" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <ContentControl Grid.Column="1" ContentTemplate="{StaticResource SubnetIconTemplate}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="5">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="الراوتر / البوابة" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        <TextBlock x:Name="GatewayText" Text="—" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,0" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <ContentControl Grid.Column="1" ContentTemplate="{StaticResource RouterIconTemplate}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="5">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="عنوان هذا الكمبيوتر" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        <TextBlock x:Name="LocalIpText" Text="—" FontSize="19" FontWeight="SemiBold" Margin="0,7,0,0" FlowDirection="LeftToRight"/>
                    </StackPanel>
                    <ContentControl Grid.Column="1" ContentTemplate="{StaticResource ComputerIconTemplate}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" Height="42" VerticalContentAlignment="Center"
                     ToolTip="ابحث باسم الجهاز أو الشركة أو IP أو MAC" TextChanged="SearchBox_TextChanged"/>
            <TextBlock Grid.Column="1" Text="بحث" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0"/>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0" ClipToBounds="True">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabItem x:Name="DevicesTab" Header="الأجهزة الآن" IsSelected="True">
                    <DataGrid x:Name="DevicesGrid"
                              ItemsSource="{Binding DevicesView}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Background="{StaticResource PanelBrush}"
                              RowHeaderWidth="0"
                              SelectionMode="Extended"
                              AlternatingRowBackground="#101A22">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="58">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Style="{StaticResource DeviceIconHostStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="نوع الجهاز" Binding="{Binding DeviceType}" Width="155"/>
                            <DataGridTextColumn Header="الشركة" Binding="{Binding Vendor}" Width="125"/>
                            <DataGridTextColumn Header="اسم الجهاز" Binding="{Binding HostName}" Width="*"/>
                            <DataGridTextColumn Header="MAC Address" Binding="{Binding MacAddress}" Width="175"/>
                            <DataGridTextColumn Header="IP Address" Binding="{Binding Ip}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem x:Name="HistoryTab" Header="سجل الأجهزة">
                    <Grid Background="{StaticResource PanelBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="14,10,14,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الأجهزة التي ظهرت على هذه الشبكة" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="يحفظ أول ظهور وآخر ظهور محليًا على هذا الكمبيوتر فقط." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Click="ClearHistoryButton_Click" Background="#392228" BorderBrush="#66323C" Padding="14,8">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="مسح السجل" VerticalAlignment="Center"/>
                                    <ContentControl ContentTemplate="{StaticResource TrashIconTemplate}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding HistoryView}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  Background="{StaticResource PanelBrush}"
                                  RowHeaderWidth="0"
                                  AlternatingRowBackground="#101A22">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="54">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Style="{StaticResource DeviceIconHostStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="110"/>
                                <DataGridTextColumn Header="النوع" Binding="{Binding DeviceType}" Width="150"/>
                                <DataGridTextColumn Header="الشركة" Binding="{Binding Vendor}" Width="120"/>
                                <DataGridTextColumn Header="اسم الجهاز" Binding="{Binding HostName}" Width="*"/>
                                <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="170"/>
                                <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="135"/>
                                <DataGridTextColumn Header="أول ظهور" Binding="{Binding FirstSeen}" Width="145"/>
                                <DataGridTextColumn Header="آخر ظهور" Binding="{Binding LastSeen}" Width="145"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="StatusText" Text="جاهز للفحص" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                <ProgressBar x:Name="ScanProgress" Height="5" Margin="0,7,0,0" Minimum="0" Maximum="100" Value="0" Background="#1C2933" Foreground="{StaticResource AccentBrush}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="بيانات MAC والسجل تبقى محليًا على جهازك" Foreground="#718492" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </Grid>
    </Grid>
</Window>
