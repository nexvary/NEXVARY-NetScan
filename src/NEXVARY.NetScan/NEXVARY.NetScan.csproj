<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NEXVARY-NetScan</AssemblyName>
    <RootNamespace>NEXVARY.NetScan</RootNamespace>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>0.2.7</Version>
    <Company>NEXVARY</Company>
    <Product>NEXVARY NetScan</Product>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="Assets/vendors.tsv" /><Resource Include="Assets/AppIcon.ico" /><Resource Include="Assets/AppLogo.png" /></ItemGroup>
</Project>
